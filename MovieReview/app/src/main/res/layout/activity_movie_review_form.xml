<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Novo Filme"
            android:textColor="#1A1A1A"
            android:textSize="32sp"
            android:textStyle="bold"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adicione um filme à sua coleção"
            android:textColor="#666666"
            android:textSize="15sp"
            android:paddingBottom="28dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Título do filme"
            android:textColor="#333333"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <EditText
            android:id="@+id/etMovieName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex.: Interestelar"
            android:inputType="textCapSentences"
            android:textColor="#1A1A1A"
            android:textColorHint="#999999"
            android:padding="14dp"
            android:textSize="16sp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gênero"
            android:textColor="#333333"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <Spinner
            android:id="@+id/spGenre"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:padding="8dp"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sua nota"
            android:textColor="#333333"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <RatingBar
            android:id="@+id/ratingMovie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="1"
            android:rating="3"
            android:progressTint="#FBBF24"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comentário"
            android:textColor="#333333"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <EditText
            android:id="@+id/etMovieReview"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="O que você achou do filme?"
            android:gravity="top"
            android:inputType="textCapSentences|textMultiLine"
            android:textColor="#1A1A1A"
            android:textColorHint="#999999"
            android:padding="14dp"
            android:textSize="16sp"
            android:layout_marginBottom="28dp"/>

        <Button
            android:id="@+id/btnSaveMovie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvar filme"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnCancelMovie"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>

</ScrollView>
